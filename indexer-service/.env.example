# Service Configuration
SERVICE_NAME=indexer-service
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@postgres:5432/search_engine

# Kafka Configuration
KAFKA_BROKER=kafka:9092
PAGE_CRAWLED_TOPIC=page_crawled
KAFKA_GROUP_ID=indexer-group
KAFKA_AUTO_OFFSET_RESET=earliest

# Indexer & Tokenizer Settings
MIN_WORD_LENGTH=2
MAX_WORD_LENGTH=50
